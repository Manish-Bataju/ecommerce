import React from 'react';
import { useForm, useFieldArray, useWatch } from 'react-hook-form';
import { 
  Category_Map, 
  Clothing_Category_Map, 
  Fabric_Category, 
  Product_Tag_Groups 
} from '../data/CategoryConfig.js';

// --- SUB-COMPONENT: NESTED INVENTORY ---
const InventorySection = ({ vIdx, control, register, sizes }) => {
  const { fields, append, remove } = useFieldArray({
    control,
    name: `variants.${vIdx}.inventory`
  });

  return (
    <div className="bg-slate-50 p-4 rounded-xl space-y-3 border border-slate-200">
      <div className="flex justify-between items-center">
        <label className="text-[10px] font-bold text-slate-500 uppercase">Stock Levels</label>
        <button 
          type="button" 
          onClick={() => append({ size: '', stock: 0 })}
          className="text-blue-600 text-[10px] font-bold hover:underline"
        >
          + ADD SIZE
        </button>
      </div>
      {fields.map((field, sIdx) => (
        <div key={field.id} className="flex gap-2 items-center">
          <select 
            {...register(`variants.${vIdx}.inventory.${sIdx}.size`)} 
            className="flex-1 p-2 border rounded bg-white text-sm"
          >
            <option value="">Select Size</option>
            {sizes?.map(s => <option key={s} value={s}>{s}</option>)}
          </select>
          <input 
            type="number" 
            {...register(`variants.${vIdx}.inventory.${sIdx}.stock`)} 
            placeholder="Qty" 
            className="w-20 p-2 border rounded text-sm" 
          />
          {fields.length > 1 && (
            <button type="button" onClick={() => remove(sIdx)} className="text-red-400">×</button>
          )}
        </div>
      ))}
    </div>
  );
};

// --- SUB-COMPONENT: VARIANT CARD ---
const VariantCard = ({ vIdx, register, watch, control, selectedAgeGroup, setValue }) => {
  // 1. Watch the images and the index
  const galleryFiles = watch(`variants.${vIdx}.images`);
  const selectedSwatchIndex = watch(`variants.${vIdx}.swatchIndex`) || 0;
  const swatchZoom = watch(`variants.${vIdx}.swatchZoom`) || 140;

  const [previews, setPreviews] = React.useState([]);

  // 2. Enhanced Effect to generate thumbnails
  React.useEffect(() => {
    if (galleryFiles && galleryFiles.length > 0) {
      // Convert FileList to a real Array to map it
      const filesArray = Array.from(galleryFiles);
      const urls = filesArray.map(file => URL.createObjectURL(file));
      
      setPreviews(urls);

      // Cleanup to prevent memory leaks
      return () => urls.forEach(url => URL.revokeObjectURL(url));
    }
  }, [galleryFiles]); // Triggers every time new files are picked

  return (
    <div className="p-6 border-2 rounded-2xl space-y-6 bg-white relative shadow-sm border-slate-100">
      
      {/* SECTION: NAMES (Flexible Logic) */}
      <div className="flex justify-between items-start gap-4">
        <div className="flex-1 grid grid-cols-2 gap-4">
          <div className="flex flex-col">
            <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Color Name</label>
            <input 
               {...register(`variants.${vIdx}.color`)} 
               placeholder="e.g. Sage Green" 
               className="p-2 border-b focus:border-blue-500 outline-none font-semibold" 
            />
          </div>
          <div className="flex flex-col">
            <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Print Name (Optional)</label>
            <input 
               {...register(`variants.${vIdx}.printName`)} 
               placeholder="e.g. Floral Print" 
               className="p-2 border-b focus:border-blue-500 outline-none text-slate-500" 
            />
          </div>
        </div>
      </div>

      {/* SECTION: SMART SWATCH PREVIEW */}
      <div className="flex items-center gap-6 p-4 bg-slate-50 rounded-2xl border border-slate-100">
        <div className="w-20 h-20 rounded-full border-4 border-white shadow-xl bg-slate-200 overflow-hidden shrink-0">
          {previews[selectedSwatchIndex] ? (
            <img 
              src={previews[selectedSwatchIndex]} 
              className="w-full h-full object-cover" 
              style={{ transform: `scale(${swatchZoom / 100})` }}
            />
          ) : (
            <div className="w-full h-full flex items-center justify-center text-[10px] text-slate-400 text-center px-2">
              Upload images to pick swatch
            </div>
          )}
        </div>
        <div className="flex-1">
           <label className="text-[10px] font-bold text-slate-500 uppercase">Swatch Zoom</label>
           <input 
             type="range" min="100" max="250" 
             {...register(`variants.${vIdx}.swatchZoom`)}
             className="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 mt-2"
           />
        </div>
      </div>

      {/* SECTION: VISUAL GALLERY GRID */}
      <div className="space-y-3">
        <div className="flex justify-between items-center">
          <h4 className="text-[10px] font-bold text-slate-500 uppercase">Gallery & Swatch Selection</h4>
          <label className="cursor-pointer bg-blue-600 text-white px-4 py-1.5 rounded-full text-[10px] font-bold hover:bg-blue-700">
            SELECT IMAGES
            <input type="file" multiple {...register(`variants.${vIdx}.images`)} className="hidden" />
          </label>
        </div>

        <div className="grid grid-cols-4 sm:grid-cols-6 gap-3 min-h-20">
          {previews.map((url, imgIdx) => (
            <div 
              key={imgIdx}
              onClick={() => setValue(`variants.${vIdx}.swatchIndex`, imgIdx)}
              className={`
                relative aspect-square rounded-xl overflow-hidden cursor-pointer border-2 transition-all duration-300
                hover:scale-110 hover:z-10 hover:shadow-lg
                ${selectedSwatchIndex === imgIdx ? 'border-blue-600 ring-2 ring-blue-100' : 'border-white'}
              `}
            >
              <img src={url} className="w-full h-full object-cover transition-transform duration-500 hover:scale-125" />
              {selectedSwatchIndex === imgIdx && (
                <div className="absolute inset-0 bg-blue-600/20 flex items-center justify-center">
                  <div className="bg-blue-600 text-white rounded-full p-1 shadow-md">
                    <svg className="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" /></svg>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <InventorySection vIdx={vIdx} control={control} register={register} sizes={Category_Map[selectedAgeGroup]?.sizes} />
    </div>
  );
};

// --- MAIN FORM ---
const ProductForm = () => {
  const { register, control, watch, setValue, handleSubmit, formState: { errors } } = useForm({
    defaultValues: {
      title: '',
      description: '',
      price: '',
      finalPrice: '',
      ageGroup: 'baby',
      fabric: '100% Cotton',
      tags: [],
      variants: [{ color: '', printName: '', swatchImage: '', images: [], inventory: [{ size: '', stock: 0 }] }]
    }
  });

  const { fields, append, remove } = useFieldArray({ control, name: "variants" });
  const selectedAgeGroup = useWatch({ control, name: "ageGroup", defaultValue: "baby" });
  const selectedTags = useWatch({
    control,
    name: "tags",
    defaultValue: []
  });

  const selectedFabric = useWatch({ control, name: "fabric" });

React.useEffect(() => {
  if (selectedFabric) {
    // Automatically add the selected fabric to your tags if it's not there
    if (!selectedTags.includes(selectedFabric)) {
      setValue("tags", [...selectedTags, selectedFabric]);
    }
  }
}, [selectedFabric, selectedTags, setValue]);

  const toggleTag = (tag) => {
    const current = [...selectedTags];
    const next = current.includes(tag) ? current.filter(t => t !== tag) : [...current, tag];
    setValue("tags", next, {shouldValidate: true, shouldDirty: true});
  };

  const onSubmit = (data) => console.log("Final Product Data:", data);

  return (
    <form onSubmit={handleSubmit(onSubmit)} className=" flex flex-col gap-2 max-w-3xl left-0 p-6">
        <h1 className='text-center text-3xl font-bold tracking-wide'>Product Form</h1>
        <div>
        <label htmlFor="">Title</label>
        <input type="text" {...register("title")} className="w-full p-2 border border-slate-300 rounded-lg" />
        {errors.title && <span className='text-red-500'>{errors.title.message}</span>}
        </div>
        
        <div>
            <label htmlFor="">Description</label>
            <textarea type="text" {...register("description")} className='w-full h-1/2 p-2 border border-slate-300 rounded-lg' />
            {errors.description && <span className='text-red-500'>{errors.description.message}</span>}
           </div>   
        
        
        <div className='flex w-full items-center justify-between'>
            <div>
                <label htmlFor="">Price</label>
                <input type="number" {...register("price")} className="w-full p-2 border border-slate-300 rounded-lg" /> 
                {errors.price && <span className='text-red-500'>{errors.price.message}</span>}
            </div>
           
            <div>
                <label htmlFor=""className='right-0'>Final Price</label>
                <input type="number" {...register("finalPrice")} className="w-full p-2 border border-slate-300 rounded-lg" />
                {errors.finalPrice && <span className='text-red-500'>{errors.finalPrice.message}</span>}
            </div>    
        </div>
        

      {/* SECTION 1: CORE SPECS */}
      <div className="flex justify-between gap-6 p-6 text-white ">
        <div>
          <label className="text-[14px] font-bold uppercase text-black">Fabric</label>
          <select {...register("fabric")} className="w-full p-2 bg-navy border-none rounded-lg text-sm">
            {Fabric_Category.map(f => <option key={f} value={f}>{f}</option>)}
          </select>
        </div>
        <div>
          <label className="text-[14px] font-bold uppercase text-black">Category</label>
          <select {...register("clothingCategory")} className="w-full p-2 bg-navy border-none rounded-lg text-sm">
            {Clothing_Category_Map.map(c => <option key={c} value={c}>{c}</option>)}
          </select>
        </div>
        <div>
          <label className="text-[14px] font-bold uppercase text-black">Age Group</label>
          <select {...register("ageGroup")} className="w-full p-2 bg-navy border-none rounded-lg text-sm">
            {Object.keys(Category_Map).map(k => <option key={k} value={k}>{k.toUpperCase()}</option>)}
          </select>
        </div>
      </div>

      {/* SECTION 2: TAGS */}
      <div className="space-y-4">
        <h3 className="font-bold text-slate-800 uppercase text-sm tracking-widest">Product Tags</h3>
        {Object.entries(Product_Tag_Groups).map(([group, tags]) => (
          <div key={group} className="flex gap-2 flex-wrap items-center">
            <span className="text-[12px] font-black text-black uppercase w-20">{`${group}:`}</span>
            <div className='flex gap-2 flex-wrap'>
                {tags.map(tag => (
              <button key={tag} type="button" onClick={() => toggleTag(tag)}
                className={`px-3 py-1 rounded-full text-[12px] font-bold transition-all border ${selectedTags.includes(tag) ? 'bg-blue-600 border-blue-600 text-white' : 'bg-white text-slate-500 hover:border-slate-400'}`}>
                {tag}
              </button>
            ))}
            </div>
            
          </div>
        ))}
      </div>

      {/* SECTION 3: VARIANTS */}
      <div className="space-y-6 mt-5 ">
        <div className="flex justify-between items-center px-2">
          <h2 className="text-2xl font-black text-slate-800">VARIATIONS</h2>
          <button type="button" onClick={() => append({ color: '', printName: '', swatchImage: '', images: [], inventory: [{size: '', stock: 0}] })}
            className="bg-blue-600 text-white px-6 py-2 rounded-full text-xs font-bold shadow-lg shadow-blue-200">
            + ADD COLOR
          </button>
        </div>

        <div className="grid grid-cols-1 gap-8 w-full">
          {fields.map((field, vIdx) => (
            <VariantCard 
              key={field.id} 
              vIdx={vIdx} 
              register={register} 
              watch={watch} 
              remove={remove} 
              control={control} 
              selectedAgeGroup={selectedAgeGroup} 
             />
          ))}
        </div>
      </div>

      <button type="submit" className="w-full py-5 bg-slate-900 text-white rounded-3xl font-black text-lg shadow-2xl hover:scale-[1.01] transition-transform">
        SAVE PRODUCT TO DATABASE
      </button>
    </form>
  );
};

export default ProductForm;